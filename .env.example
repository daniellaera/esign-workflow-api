# Copy to .env to override defaults. All variables use the ESIGN_ prefix.
ESIGN_API_KEY=dev-api-key-change-me

# Outside Docker, run MongoDB locally as a single-node replica set.
# ESIGN_MONGO_URI=mongodb://localhost:27017/?directConnection=true
# ESIGN_MONGO_DATABASE=esign
# ESIGN_DATA_DIR=data
# ESIGN_PUBLIC_BASE_URL=http://localhost:8000

# Durations: seconds or ISO 8601.
# ESIGN_SIGNING_LINK_TTL=PT72H
# ESIGN_SIGNER_CERTIFICATE_VALIDITY=PT1H
# ESIGN_MAX_UPLOAD_BYTES=10485760

# Webhook on envelope.completed / envelope.declined.
# ESIGN_WEBHOOK_URL=https://example.com/hooks/esign
# ESIGN_WEBHOOK_SECRET=change-me
# ESIGN_WEBHOOK_MAX_RETRIES=3
# ESIGN_WEBHOOK_BACKOFF_SECONDS=1.0

# Development only: these expose signing links (bearer credentials).
# ESIGN_LOG_SIGNING_LINKS=false
# ESIGN_EXPOSE_OUTBOX=false

# ESIGN_LOG_LEVEL=INFO
