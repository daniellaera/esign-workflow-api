# Copy to deploy/demo.env on the demo host and fill in. Never commit demo.env.

# Private operator key (not published).
ESIGN_API_KEY=change-me-to-a-long-random-value
# Public key shown in the README and in Swagger.
ESIGN_DEMO_API_KEY=esign-demo-public-key
# Public address; used to build signing links.
ESIGN_PUBLIC_BASE_URL=https://esign.example.com
# Address of the reverse proxy, the only peer allowed to set X-Forwarded-For.
ESIGN_TRUSTED_PROXIES=["203.0.113.10"]

# Optional overrides (defaults shown).
# ESIGN_DEMO_RETENTION=PT24H
# ESIGN_DEMO_CLEANUP_INTERVAL=PT10M
# ESIGN_RATE_LIMIT_PER_MINUTE=30
# ESIGN_ENVELOPE_LIMIT_PER_HOUR=10
